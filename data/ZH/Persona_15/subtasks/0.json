{
  "persona": "涛在郑州附近黄河边的一座水文监测站工作。他测量河水浑浊程度，以安排水库冲沙，防止“地上悬河”溢出。",
  "task": "根据河水浑浊度规则和今天的读数，在每日日志表中填写“冲沙”或“监控”。",
  "required_files": [
    "yr_notice.txt",
    "water_readings.xlsx",
    "dialogue_zhengzhou_turbidity.txt",
    "yellowriver_station_context.xlsx"
  ],
  "output_files": [
    "data/ops_log.xlsx"
  ],
  "evaluation": [
    {
      "function": "evaluate_excel_cell_value",
      "args": {
        "file": "./data/ops_log.xlsx",
        "matches": [
          {
            "row": 2,
            "col": 2,
            "value": "冲沙"
          }
        ]
      }
    }
  ],
  "target_files": [
    {
      "path": "data/ops_log.xlsx",
      "change": "modify",
      "cells": [
        {
          "sheet": null,
          "row": 2,
          "col": 2
        }
      ]
    }
  ]
}