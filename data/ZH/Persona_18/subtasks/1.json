        "file": "./data/habitat_planning.pdf",
        "keywords": [
          "竹林恢复最低海拔：1800m"
        ]
      }
    }
  ],
  "target_files": [
    {
      "path": "data/habitat_planning.pdf",
      "change": "modify"
    },
    {
      "path": "data/habitat_planning.docx",
      "change": "create"
    }
  ]
