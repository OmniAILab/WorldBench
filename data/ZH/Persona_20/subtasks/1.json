    "local_context_guangzhou_ancestral_hall.xlsx"
  ],
  "output_files": [
    "data/master_plan_zoning.xlsx"
  ],
  "evaluation": [
    {
      "function": "evaluate_excel_cell_value",
      "args": {
        "file": "./data/master_plan_zoning.xlsx",
        "matches": [
          {
            "row": 2,
            "col": 2,
            "value": "Protected_Lingnan"
          }
        ]
      }
    }
  ],
  "target_files": [
    {
      "path": "data/master_plan_zoning.xlsx",
