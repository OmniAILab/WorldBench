{
  "persona": "博是大连的一名本地拖船船长。他利用船上的声呐在渤海寻找丢失的集装箱，并在恶劣的冬季飑风来临时努力保护船员安全。",
  "task": "根据声呐日志找出最可能存在丢失集装箱的位置，并把坐标写入潜水计划表。",
  "required_files": [
    "sonar_dalian.xlsx",
    "sonar_note_dalian.txt",
    "dialogue_dalian_sonar.txt",
    "dalian_sonar_signature.xlsx"
  ],
  "output_files": [
    "data/dive_plan_dalian.xlsx"
  ],
  "evaluation": [
    {
      "function": "evaluate_excel_cell_value",
      "args": {
        "file": "./data/dive_plan_dalian.xlsx",
        "matches": [
          {
            "row": 2,
            "col": 2,
            "value": "39.1N_121.7E"
          }
        ]
      }
    }
  ],
  "target_files": [
    {
      "path": "data/dive_plan_dalian.xlsx",
      "change": "modify",
      "cells": [
        {
          "sheet": null,
          "row": 2,
          "col": 2
        }
      ]
    }
  ]
}