{
  "persona": "素兰是在广州一个热闹电子市场工作的出口文员。她为从南沙港发出的货物填写海关表格，计算复杂的增值税税率，还常常抱怨南方潮湿闷热的天气。",
  "task": "核对南沙港代理约定的离港后 24 小时电子文件操作流程、NS-21 离港计划、粤港澳大湾区转运背景和单证交班对话。以参考日期 2026-03-18 为当前工作日：NS-21 当天 10:00 离港，因此在追踪表标记“今日启动提交=是”，并按该业务流程计算最迟提交时间为次日 10:00，同时写入“离港后24小时”依据。不要把装柜照片当天归档要求误当成电子文件截止时间。",
  "required_files": [
    "nansha_notice.txt",
    "schedule_gz.xlsx",
    "nansha_transshipment_gz.xlsx",
    "dialogue_filing_nansha_gz.txt"
  ],
  "output_files": [
    "data/filing_tracker_gz.xlsx"
  ],
  "evaluation": [
    {
      "function": "evaluate_excel_cell_value",
      "args": {
        "file": "./data/filing_tracker_gz.xlsx",
        "matches": [
          {
            "row": 2,
            "col": 2,
            "value": "是"
          },
          {
            "row": 2,
            "col": 3,
            "value": "2026-03-19 10:00"
          },
          {
            "row": 2,
            "col": 4,
            "value": "离港后24小时"
          }
        ]
      }
    }
  ],
  "target_files": [
    {
      "path": "data/filing_tracker_gz.xlsx",
      "change": "modify",
      "cells": [
        {
          "sheet": null,
          "row": 2,
          "col": 2
        },
        {
          "sheet": null,
          "row": 2,
          "col": 3
        },
        {
          "sheet": null,
          "row": 2,
          "col": 4
        }
      ]
    }
  ]
}